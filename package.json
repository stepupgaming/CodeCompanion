{
  "name": "patch",
  "productName": "Patch",
  "version": "0.3.0",
  "description": "AI coding assistant desktop app",
  "author": "PierrunoYT <pierrebruno@hotmail.ch>",
  "license": "MIT",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "icons": "node scripts/generate-icons.mjs",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:e2e": "npm run build && vitest run --project e2e",
    "perf": "npm run build && vitest run --project perf",
    "pack": "node scripts/ensure-closed.mjs && npm run build && electron-builder --dir --publish never",
    "dist": "node scripts/ensure-closed.mjs && npm run build && electron-builder --publish never"
  },
  "build": {
    "appId": "codecompanion",
    "productName": "Patch",
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "default",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}.${ext}",
      "category": "public.app-category.developer-tools",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Installer.${ext}",
      "uninstallDisplayName": "${productName}"
    },
    "dmg": {
      "artifactName": "${productName}.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.16",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "marked-highlight": "^2.2.4",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@mozilla/readability": "^0.6.0",
    "diff": "^9.0.0",
    "ignore": "^7.0.10",
    "linkedom": "^0.18.13",
    "node-pty": "^1.1.0",
    "openai": "^7.23.0",
    "simple-git": "^4.0.2",
    "zod": "^4.6.5"
  }
}
